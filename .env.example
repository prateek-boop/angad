# Add at least one long random key before exposing the API beyond localhost.
SHIELDNET_API_KEYS=replace-with-a-long-random-api-key
SHIELDNET_DATA_DIR=/app/data

# Reputation lookups do not fetch the submitted page.
SHIELDNET_REPUTATION_NETWORK_ENABLED=true

# All tiers are enabled by default. Set to false to disable live
# page fetching (tier2/tier3) or browser screenshot analysis (tier4).
SHIELDNET_LIVE_FETCH_ENABLED=true
SHIELDNET_VISUAL_ANALYSIS_ENABLED=true

SHIELDNET_BLOCK_RISK_THRESHOLD=0.65
SHIELDNET_REVIEW_RISK_THRESHOLD=0.40
SHIELDNET_DEFAULT_SCAN_TIMEOUT_MS=30000
SHIELDNET_MAX_SCAN_TIMEOUT_MS=60000
SHIELDNET_MAX_FETCH_BYTES=2097152
SHIELDNET_MAX_BATCH_SIZE=50
SHIELDNET_MAX_NETWORK_BATCH_SIZE=10


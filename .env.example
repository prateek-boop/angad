# ShieldNet Environment Configuration Example
# Copy this file to .env before starting containers

# Secret API key(s) for authentication (comma-separated if multiple)
SHIELDNET_API_KEYS=shieldnet-dev-key

# Storage path for local databases, visual reference cache, and logs
SHIELDNET_DATA_DIR=/app/data

# Execution toggles for live analysis tiers
SHIELDNET_REPUTATION_NETWORK_ENABLED=true
SHIELDNET_LIVE_FETCH_ENABLED=true
SHIELDNET_VISUAL_ANALYSIS_ENABLED=true

# Model inference backend (onnx)
MODEL_BACKEND=onnx

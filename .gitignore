# secrets / local env
.env

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/

# test / lint caches
.coverage
.pytest_cache/
.ruff_cache/

# raw training datasets & runtime sqlite databases
data/*.sqlite3
data/*.cache
data/*.csv
data/*.parquet

# Keep reference stores and configurations in data/
!data/visual_reference_store.json

# Explicitly ensure models and android assets are tracked
!*.onnx
!ml_engine/saved_model/onnx/
!android/src/main/assets/

# OS cruft
.DS_Store

{
  "manifest_version": 3,
  "name": "ShieldNet URL Scanner",
  "version": "1.0.0",
  "description": "Manually scan the current page or a link with a local ShieldNet service.",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Scan with ShieldNet",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}

